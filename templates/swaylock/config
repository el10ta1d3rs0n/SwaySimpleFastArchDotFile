# --- General Options ---
daemonize
show-failed-attempts
ignore-empty-password

# --- Solid Background ---
color=282A36

# --- Font (System Default) ---
font=monospace
font-size=16

# --- Medium Size Indicator & Controlled Thickness ---
indicator-radius=130
indicator-thickness=4

# --- Dracula Theme Colors ---
line-color=282A36
ring-color=BD93F9
inside-color=282A36
key-hl-color=50FA7B
separator-color=00000000
text-color=F8F8F2
text-caps-lock-color=""

# --- Verifying State ---
line-ver-color=BD93F9
ring-ver-color=BD93F9
inside-ver-color=282A36
text-ver-color=8BE9FD

# --- Wrong Password State ---
ring-wrong-color=FF5555
text-wrong-color=FF5555
inside-wrong-color=282A36
line-wrong-color=282A36

# --- Clear / Backspace State ---
inside-clear-color=282A36
text-clear-color=8BE9FD
ring-clear-color=8BE9FD
line-clear-color=8BE9FD
bs-hl-color=8BE9FD
